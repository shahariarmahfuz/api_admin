# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# Redis (optional, fallback in-memory rate limiter and caching active when empty)
REDIS_URL=

# Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
API_SECRET=replace_with_a_secure_random_api_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment & CORS
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Initial Admin Setup
ADMIN_DEFAULT_EMAIL=admin@orvia.dev
ADMIN_DEFAULT_PASSWORD=OrviaAdmin2026!
PORT=8000
